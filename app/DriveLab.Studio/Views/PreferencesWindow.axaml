<!-- ============================================================================
     DriveLab
     PreferencesWindow.axaml — preferências do APLICATIVO (não do hardware).

     Vive numa janela própria, e não num cartão do painel: o painel é dos
     dispositivos — base, pedais, freio de mão —, e um cartão de caixas de
     seleção no meio deles não é um dispositivo. Ficava com cara de puxadinho.

     A explicação do porquê fica junto de CADA opção, curta, em vez de um
     parágrafo no topo que ninguém lê e que empurra os controles para baixo.
     Autor: Luciano Tomé <lucianotome1970@gmail.com>
     Copyright (c) 2026 Luciano Tomé — Licença MIT
============================================================================ -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DriveLab.Studio.ViewModels"
        xmlns:loc="using:DriveLab.Studio.Localization"
        x:Class="DriveLab.Studio.Views.PreferencesWindow"
        x:DataType="vm:HomeViewModel"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Translate Prefs_Title}"
        Background="{DynamicResource DlBackground}">
    <StackPanel Margin="24" Spacing="20">

        <TextBlock Text="{loc:Translate Prefs_Title}" Classes="h2" />

        <StackPanel Spacing="6">
            <CheckBox IsChecked="{Binding IniciarComWindows}"
                      Content="{loc:Translate Home_StartWithWindows}"
                      Foreground="{DynamicResource DlText}" />
            <TextBlock Text="{loc:Translate Prefs_StartHint}" TextWrapping="Wrap"
                       FontSize="11" Opacity="0.6" Margin="28,0,0,0"
                       Foreground="{DynamicResource DlText}" />
        </StackPanel>

        <StackPanel Spacing="6">
            <CheckBox IsChecked="{Binding ManterNaBandeja}"
                      Content="{loc:Translate Home_KeepInTray}"
                      Foreground="{DynamicResource DlText}" />
            <TextBlock Text="{loc:Translate Prefs_TrayHint}" TextWrapping="Wrap"
                       FontSize="11" Opacity="0.6" Margin="28,0,0,0"
                       Foreground="{DynamicResource DlText}" />
        </StackPanel>

        <Button Content="{loc:Translate Prefs_Close}" Click="Fechar_Click"
                HorizontalAlignment="Right" Padding="20,7" />
    </StackPanel>
</Window>
