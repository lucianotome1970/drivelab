<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DriveLab.Studio.ViewModels"
             xmlns:av="using:Avalonia.Data.Converters"
             xmlns:loc="using:DriveLab.Studio.Localization"
             x:Class="DriveLab.Studio.Views.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">
    <Border Classes="card">
        <Grid RowDefinitions="Auto,Auto,*">
            <!-- Cabeçalho: o título do módulo vive no topo do app ("DriveLab Studio — Base do Volante").
                 Aqui só as ações (dir). -->
            <!-- RESULTADO DO SALVAR — ACIMA dos botões e COLORIDO pelo desfecho.
                 Ficava embaixo, sobreposto ao conteúdo e sempre da mesma cor: um "salvo" tinha
                 exatamente a mesma aparência de um "não gravou", e quem acabou de clicar precisava
                 LER para saber o que houve. Verde e vermelho respondem antes da leitura; o texto
                 explica só quando é preciso explicar. -->
            <Border Grid.Row="0" Margin="0,0,0,10" CornerRadius="6" Padding="12,8"
                    IsVisible="{Binding MensagemDeSalvar, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border.Styles>
                    <Style Selector="Border">
                        <Setter Property="Background" Value="#33E74C3C" />
                        <Setter Property="BorderBrush" Value="#88E74C3C" />
                        <Setter Property="BorderThickness" Value="1" />
                    </Style>
                </Border.Styles>
                <Panel>
                    <Border Background="#332ECC71" BorderBrush="#882ECC71" BorderThickness="1"
                            CornerRadius="6" Margin="-13,-9,-13,-9"
                            IsVisible="{Binding SalvarDeuCerto}" />
                    <TextBlock Text="{Binding MensagemDeSalvar}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource DlText}" />
                </Panel>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <!-- Retorno da última exportação/importação. Fica à ESQUERDA, na mesma linha dos
                     botões: é onde o olho já está depois de clicar, e não empurra o conteúdo. -->
                <TextBlock Grid.Column="0" Text="{Binding ExchangeStatus}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"
                           Foreground="{DynamicResource DlMuted}"
                           IsVisible="{Binding ExchangeStatus, Converter={x:Static av:StringConverters.IsNotNullOrEmpty}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <!-- Arquivo de perfil: guardar um ajuste bom antes de experimentar outro, levar
                         para outra máquina, compartilhar. Some quando não há seletor de arquivo. -->
                    <Button Content="{loc:Translate Profile_Export}" Command="{Binding ExportCommand}"
                            IsVisible="{Binding CanExchangeFiles}" />
                    <Button Content="{loc:Translate Profile_Import}" Command="{Binding ImportCommand}"
                            IsVisible="{Binding CanExchangeFiles}" />
                    <Button Content="{loc:Translate Default}" Command="{Binding ResetDefaultsCommand}" />
                    <!-- Grava na flash da base (BaseCommand.SaveSettings); habilitado só com alteração não salva. -->
                    <Button Classes="accent" Content="{loc:Translate SaveToController}" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="2" ItemsSource="{Binding Tabs}">
                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PageTab">
                        <TextBlock Text="{Binding Header}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:PageTab">
                        <!-- ViewLocator renderiza o conteúdo da aba (settings ou gráfico) -->
                        <ContentControl Content="{Binding Content}" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
