<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DriveLab.Studio.ViewModels"
             xmlns:conv="using:DriveLab.Studio.Converters"
             xmlns:av="using:Avalonia.Data.Converters"
             xmlns:loc="using:DriveLab.Studio.Localization"
             x:Class="DriveLab.Studio.Views.HardwareMonitorView"
             x:DataType="vm:HardwareMonitorViewModel">
    <UserControl.Resources>
        <conv:TelemetryLevelToBrushConverter x:Key="LevelBrush" />
    </UserControl.Resources>
    <Border Classes="card">
        <StackPanel Spacing="16">
            <TextBlock Text="{loc:Translate Monitor_Title}" Classes="h2" />
            <!-- Coluna de valores com LARGURA FIXA (não Auto) e alinhada à direita. Com Auto, cada vez
                 que o número ganhava ou perdia um dígito ("9.9 V" → "10.0 V") a coluna se redimensionava
                 e o valor deslizava pro lado — a 2 atualizações por segundo isso vira um tremor constante
                 na tela. Largura fixa: a borda direita fica ancorada e só os dígitos mudam. -->
            <Grid ColumnDefinitions="*,100" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Translate Monitor_BusVoltage}"
                           Foreground="{DynamicResource DlText}" Margin="0,6" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BusVoltageText}" TextAlignment="Right"
                           Foreground="{Binding BusVoltageLevel, Converter={StaticResource LevelBrush}}" Margin="0,6" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Translate Monitor_MotorCurrent}"
                           Foreground="{DynamicResource DlText}" Margin="0,6" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MotorCurrentText}" TextAlignment="Right"
                           Foreground="{DynamicResource DlMuted}" Margin="0,6" />

                <!-- Torque estimado = Kt·corrente (sem balança). Mostra "—" até o Kt ser medido/calibrado. -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Translate Monitor_EstimatedTorque}"
                           Foreground="{DynamicResource DlText}" Margin="0,6" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EstimatedTorqueText}" TextAlignment="Right"
                           Foreground="{DynamicResource DlMuted}" Margin="0,6" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Translate Monitor_FetTemp}"
                           Foreground="{DynamicResource DlText}" Margin="0,6" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FetTempText}" TextAlignment="Right"
                           Foreground="{Binding FetTempLevel, Converter={StaticResource LevelBrush}}" Margin="0,6" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Translate Monitor_MotorTemp}"
                           Foreground="{DynamicResource DlText}" Margin="0,6" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MotorTempText}" TextAlignment="Right"
                           Foreground="{Binding MotorTempLevel, Converter={StaticResource LevelBrush}}" Margin="0,6" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Translate Monitor_Clipping}"
                           Foreground="{DynamicResource DlText}" Margin="0,6" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ClippingText}" TextAlignment="Right"
                           Foreground="{Binding ClippingLevel, Converter={StaticResource LevelBrush}}" Margin="0,6" />

                <!-- Pico da sessão: o clipping ao vivo some em 500 ms, e quem está pilotando não
                     consegue olhar a tela na hora. Este é o número que se lê DEPOIS de sair do jogo. -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Translate Monitor_ClippingPeak}"
                           Foreground="{DynamicResource DlText}" Margin="0,6" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ClippingPeakText}" TextAlignment="Right"
                           Foreground="{Binding ClippingPeakLevel, Converter={StaticResource LevelBrush}}" Margin="0,6" />
            </Grid>

            <!-- Medidor do brake chopper. O resistor quase nunca esquenta (a frenagem dura
                 milissegundos), então "frio" passa a impressão de "quebrado". Estes números
                 são a evidência de que ele trabalhou — e zero acionamentos após uma sessão
                 inteira é diagnóstico: resistor desligado ou rampa mal dimensionada. -->
            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Translate Monitor_BrakeTitle}" Classes="h2" />
                <Grid ColumnDefinitions="*,100" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Translate Monitor_BrakeActivations}"
                               Foreground="{DynamicResource DlText}" Margin="0,6" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BrakeActivationsText}" TextAlignment="Right"
                               Foreground="{DynamicResource DlMuted}" Margin="0,6" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Translate Monitor_BrakeEnergy}"
                               Foreground="{DynamicResource DlText}" Margin="0,6" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BrakeEnergyText}" TextAlignment="Right"
                               Foreground="{DynamicResource DlMuted}" Margin="0,6" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Translate Monitor_BrakePeak}"
                               Foreground="{DynamicResource DlText}" Margin="0,6" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BrakePeakText}" TextAlignment="Right"
                               Foreground="{DynamicResource DlMuted}" Margin="0,6" />
                </Grid>
                <TextBlock Text="{loc:Translate Monitor_BrakeHint}" TextWrapping="Wrap"
                           Foreground="{DynamicResource DlMuted}" FontSize="12" />
            </StackPanel>

            <!-- GRAVE: a guarda do ângulo elétrico desarmou o motor. Vermelho e no TOPO dos avisos,
                 porque não é "fique de olho" — é "a base parou e não volta sozinha", e a alternativa
                 a mostrar isso é o usuário achar que quebrou algo enquanto o motor cozinha. -->
            <Border IsVisible="{Binding AngleGuardWarning, Converter={x:Static av:StringConverters.IsNotNullOrEmpty}}"
                    Background="#33F44336" BorderBrush="#F44336" BorderThickness="1"
                    CornerRadius="6" Padding="10,8">
                <TextBlock Text="{Binding AngleGuardWarning}" TextWrapping="Wrap" Foreground="#FF8A80" />
            </Border>

            <!-- Aviso (não fatal): tensão lida não bate com a variante 24V/56V selecionada. -->
            <Border IsVisible="{Binding VoltageWarning, Converter={x:Static av:StringConverters.IsNotNullOrEmpty}}"
                    Background="#33FF9800" CornerRadius="6" Padding="10,8">
                <TextBlock Text="{Binding VoltageWarning}" TextWrapping="Wrap"
                           Foreground="{DynamicResource DlAccent}" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
