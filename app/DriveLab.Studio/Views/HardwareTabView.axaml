<!-- ============================================================================
     DriveLab
     HardwareTabView.axaml — Aba de hardware: monitor, settings e o rodapé no MESMO scroll — a página inteira
     rola junto. Só o criador vê esta aba.
     Autor: Luciano Tomé — Licença MIT
============================================================================ -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DriveLab.Studio.ViewModels"
             xmlns:views="using:DriveLab.Studio.Views"
             xmlns:av="using:Avalonia.Data.Converters"
             x:Class="DriveLab.Studio.Views.HardwareTabView"
             x:DataType="vm:HardwareTabViewModel">
    <!-- Tudo (monitor + campos + rodapé) num ScrollViewer só: a página rola inteira. O monitor
         já ocupava metade da altura útil quando ficava fixo no topo. -->
    <views:SettingsGroupView>
        <views:SettingsGroupView.Header>
            <views:HardwareMonitorView Margin="0,0,0,16" DataContext="{Binding Monitor}" />
        </views:SettingsGroupView.Header>
        <views:SettingsGroupView.Footer>
              <StackPanel Spacing="0">
                <!-- Compensação de cogging: calibrar (roda na bancada) + status da tabela na flash. Só o criador. -->
                <Expander Header="Compensação de cogging" IsExpanded="False"
                          Margin="0,12,0,0" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Mede o ripple do motor (imã passando por imã) e grava uma tabela na flash do dispositivo. O firmware subtrai o ripple posição a posição — é o que deixa o hub com feel liso de DD caro." />
                        <TextBlock Text="Ainda não implementado neste firmware." TextWrapping="Wrap" FontWeight="SemiBold" />
                        <Button Classes="accent" Content="Calibrar cogging"
                                Command="{Binding CalibrateCoggingCommand}" HorizontalAlignment="Left"
                                IsEnabled="False" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Depende de um sensor de posição absoluto: a tabela de compensação é indexada pelo ângulo, e com um encoder que não guarda o zero entre um boot e outro ela sairia desalinhada — o que pioraria o feel em vez de melhorar. Volta quando o encoder magnético estiver funcionando." />
                        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding CoggingStatus}"
                                   IsVisible="{Binding CoggingStatus, Converter={x:Static av:StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Expander>
              </StackPanel>
        </views:SettingsGroupView.Footer>
    </views:SettingsGroupView>
</UserControl>
