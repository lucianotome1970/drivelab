<!-- ============================================================================
     DriveLab
     HardwareTabView.axaml — Aba de hardware: monitor no topo (fixo) e, abaixo, os settings + o export do
     perfil de hardware NO MESMO scroll (o export rola junto com os parâmetros). Só o criador vê esta aba.
     Autor: Luciano Tomé — Licença MIT
============================================================================ -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DriveLab.Studio.ViewModels"
             xmlns:views="using:DriveLab.Studio.Views"
             xmlns:av="using:Avalonia.Data.Converters"
             x:Class="DriveLab.Studio.Views.HardwareTabView"
             x:DataType="vm:HardwareTabViewModel">
    <DockPanel>
        <views:HardwareMonitorView DockPanel.Dock="Top" Margin="0,0,0,16" DataContext="{Binding Monitor}" />

        <!-- Os settings de hardware + o export (como Footer) ficam no MESMO ScrollViewer: o export rola junto. -->
        <views:SettingsGroupView>
            <views:SettingsGroupView.Footer>
              <StackPanel Spacing="0">
                <!-- Compensação de cogging: calibrar (roda na bancada) + status da tabela na flash. Só o criador. -->
                <Expander Header="Compensação de cogging" IsExpanded="False"
                          Margin="0,12,0,0" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Mede o ripple do motor (imã passando por imã) e grava uma tabela na flash do dispositivo. O firmware subtrai o ripple posição a posição — é o que deixa o hub com feel liso de DD caro." />
                        <TextBlock Text="{Binding CoggingPresentText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <Button Classes="accent" Content="Calibrar cogging"
                                Command="{Binding CalibrateCoggingCommand}" HorizontalAlignment="Left" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="A coleta EXIGE motor energizado — roda na bancada (Stage 1). Com o motor desligado, o dispositivo só registra o pedido." />
                        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding CoggingStatus}"
                                   IsVisible="{Binding CoggingStatus, Converter={x:Static av:StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Expander>

                <!-- Expander recolhido por padrão: não ocupa espaço até o criador abrir p/ exportar. -->
                <Expander Header="Exportar perfil de hardware" IsExpanded="False"
                          Margin="0,12,0,0" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Gera o hardware-profile.json com os valores atuais — para embutir no instalador do seu DD (o comprador recebe já configurado)." />
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Marca (vendor)" VerticalAlignment="Center" Classes="muted" Margin="0,0,0,6" />
                            <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Vendor}" Watermark="Ex.: Fulano DD" Margin="10,0,0,6" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Modelo (device)" VerticalAlignment="Center" Classes="muted" Margin="0,0,0,6" />
                            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding Device}" Watermark="Ex.: DD 56V 12Nm" Margin="10,0,0,6" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Notas" VerticalAlignment="Center" Classes="muted" />
                            <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding Notes}" Watermark="Motor, brake, etc. (opcional)" Margin="10,0,0,0" />
                        </Grid>
                        <Button Classes="accent" Content="Exportar perfil de hardware"
                                Command="{Binding ExportProfileCommand}" HorizontalAlignment="Left" />
                        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding ExportStatus}"
                                   IsVisible="{Binding ExportStatus, Converter={x:Static av:StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Expander>
              </StackPanel>
            </views:SettingsGroupView.Footer>
        </views:SettingsGroupView>
    </DockPanel>
</UserControl>
