============================================================================ -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DriveLab.Studio.ViewModels"
             xmlns:views="using:DriveLab.Studio.Views"
             x:Class="DriveLab.Studio.Views.AdvancedTabView"
             x:DataType="vm:AdvancedTabViewModel">
    <views:SettingsGroupView>
        <views:SettingsGroupView.Header>
            <views:ForceCurveView DataContext="{Binding Curva}" Margin="0,0,0,12" />
        </views:SettingsGroupView.Header>
    </views:SettingsGroupView>
</UserControl>
